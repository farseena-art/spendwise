#api call for register user
###
POST http://127.0.0.1:8000/v1/spending/register/
Content-Type: application/json

{
    "username":"django",
    "email":"django@gmail.com",
    "password":"Password@123"
}

#api call for getting token
###
POST http://127.0.0.1:8000/v1/spending/token/
Content-Type: application/json

{
    "username":"user",
    "password":"Password@123"
}

#api call for get
###
GET http://127.0.0.1:8000/v1/spending/me/
Accept: application/json
#Authorization: Basic django:Password@123
Authorization: Token aef049cc9323dc45da204de9414e28d947c9252f

#Expense endpoints

#api call for listing all expenses 
###
GET http://127.0.0.1:8000/v1/spending/expenses/
Accept: application/json
Authorization: Token aef049cc9323dc45da204de9414e28d947c9252f


#api call for adding expense
###
POST http://127.0.0.1:8000/v1/spending/expenses/
Content-Type: application/json
Authorization: Token aef049cc9323dc45da204de9414e28d947c9252f

{
    "title":"Shoe",
    "amount":"1000",
    "category":"SHOPPING",
    "priority":"need",
    "payment_method":"cash"
}

#api call for fetching expenses 
###
GET http://127.0.0.1:8000/v1/spending/expenses/1/
Accept: application/json
Authorization: Token aef049cc9323dc45da204de9414e28d947c9252f



#api call for UPDATING expense
###
PUT http://127.0.0.1:8000/v1/spending/expenses/2/
Content-Type: application/json
Authorization: Token aef049cc9323dc45da204de9414e28d947c9252f

{
    "id": 2,
    "title": "medicine",
    "amount": "1200.00",
    "category": "HEALTH",
    "priority": "need",
    "payment_method": "upi",
    "created_at": "2026-10-09T06:26:33.526130Z",
    "updated_at": "2026-10-09T06:26:33.526161Z",
    "owner": 1
}


#api call for delete expense
###
DELETE http://127.0.0.1:8000/v1/spending/expenses/1/
Accept: application/json
Authorization: Token aef049cc9323dc45da204de9414e28d947c9252f


